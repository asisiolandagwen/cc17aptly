<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 5: Terms & Conditions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="82dp"
            android:paddingEnd="22dp"
            android:paddingBottom="16dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terms &amp; Conditions"
                android:textColor="@color/text_black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:text="Last update: October 12, 2026"
                android:textColor="@color/text_light"
                android:textSize="8sp" />

            <!-- 1 -->
            <TextView
                style="@style/Aptly.TermsHeading"
                android:text="1. Acceptance of Terms" />
            <TextView
                style="@style/Aptly.TermsBody"
                android:text="By using Apt.ly, you agree to be bound by these terms and conditions. If you do not agree, please do not use the app." />

            <!-- 2 -->
            <TextView
                style="@style/Aptly.TermsHeading"
                android:text="2. Eligibility and Account" />
            <TextView
                style="@style/Aptly.TermsBody"
                android:text="You must be 18 or older. You are responsible for keeping your login secure and for all activity under your account. Please give accurate information." />

            <!-- 3 -->
            <TextView
                style="@style/Aptly.TermsHeading"
                android:text="3. Posting Apartments" />
            <TextView
                style="@style/Aptly.TermsBody"
                android:text="You may post only properties you have the right to lease. Details, photos, and prices must be accurate and up to date. Listings must not discriminate, and we may remove listings that break these terms." />

            <!-- 4 -->
            <TextView
                style="@style/Aptly.TermsHeading"
                android:text="4. Your Content" />
            <TextView
                style="@style/Aptly.TermsBody"
                android:text="You own what you post, and you allow us to display it in the app. Upload only photos and text you have the right to use." />

            <!-- 5 -->
            <TextView
                style="@style/Aptly.TermsHeading"
                android:text="5. Privacy Policy" />
            <TextView
                style="@style/Aptly.TermsBody"
                android:text="Your use of the app is also governed by our Privacy Policy and the Data Privacy Act of 2012 (RA 10173). To access, correct, or delete your data, email apt.lycompany@gmail.com" />

            <!-- 6 -->
            <TextView
                style="@style/Aptly.TermsHeading"
                android:text="6. Our Role and Liability" />
            <TextView
                style="@style/Aptly.TermsBody"
                android:text="We are a platform, not a landlord, agent, or party to any rental agreement. The app is provided “as is,” and as far as the law allows, we are not liable for losses from dealings with other users." />

            <!-- 7 -->
            <TextView
                style="@style/Aptly.TermsHeading"
                android:text="7. Termination and Changes" />
            <TextView
                style="@style/Aptly.TermsBody"
                android:text="We may suspend accounts that break these terms, and you may delete your account anytime. We may update these terms and will notify you in the app." />

            <!-- 8 -->
            <TextView
                style="@style/Aptly.TermsHeading"
                android:text="8. Governing Law and Contact" />
            <TextView
                style="@style/Aptly.TermsBody"
                android:text="Philippine law applies, and disputes go to the courts of Baguio city, Benguet. Contact: +63 1234567890, apt.lycompany@gmail.com" />
        </LinearLayout>
    </ScrollView>

    <!-- Okay button -->
    <Button
        android:id="@+id/btn_okay"
        style="@style/Aptly.Button"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="48dp"
        android:text="Okay" />
</LinearLayout>