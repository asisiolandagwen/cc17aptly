<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 11b: PROFILE tab -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="21dp"
            android:paddingTop="56dp"
            android:paddingEnd="23dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="@color/text_black"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/img_profile"
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:layout_marginTop="54dp"
                android:background="@drawable/bg_circle"
                android:clipToOutline="true"
                android:contentDescription="Profile photo"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_photo" />

            <TextView
                android:id="@+id/txt_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/profile_name"
                android:textColor="@color/green_dark"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:layout_marginBottom="12dp"
                android:paddingStart="10dp"
                android:text="Personal Information"
                android:textColor="@color/text_black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Legal name -->
            <LinearLayout style="@style/Aptly.ProfileRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Aptly.ProfileLabel" android:text="Legal name" />
                    <TextView
                        android:id="@+id/txt_legal_name"
                        style="@style/Aptly.ProfileValue"
                        android:text="@string/profile_name" />
                </LinearLayout>
                <TextView android:id="@+id/edit_name" style="@style/Aptly.ProfileEdit" />
            </LinearLayout>
            <View style="@style/Aptly.Divider" />

            <!-- Phone number -->
            <LinearLayout style="@style/Aptly.ProfileRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Aptly.ProfileLabel" android:text="Phone number" />
                    <TextView
                        android:id="@+id/txt_phone"
                        style="@style/Aptly.ProfileValue"
                        android:text="@string/profile_phone" />
                </LinearLayout>
                <TextView android:id="@+id/edit_phone" style="@style/Aptly.ProfileEdit" />
            </LinearLayout>
            <View style="@style/Aptly.Divider" />

            <!-- Email -->
            <LinearLayout style="@style/Aptly.ProfileRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Aptly.ProfileLabel" android:text="Email" />
                    <TextView
                        android:id="@+id/txt_email"
                        style="@style/Aptly.ProfileValue"
                        android:text="@string/profile_email" />
                </LinearLayout>
                <TextView android:id="@+id/edit_email" style="@style/Aptly.ProfileEdit" />
            </LinearLayout>
            <View style="@style/Aptly.Divider" />

            <!-- Address -->
            <LinearLayout style="@style/Aptly.ProfileRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Aptly.ProfileLabel" android:text="Address" />
                    <TextView
                        android:id="@+id/txt_address"
                        style="@style/Aptly.ProfileValue"
                        android:text="@string/profile_address" />
                </LinearLayout>
                <TextView android:id="@+id/edit_address" style="@style/Aptly.ProfileEdit" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation (Profile selected) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_nav"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="5dp">

        <LinearLayout android:id="@+id/nav_explore" style="@style/Aptly.NavItem">
            <ImageView style="@style/Aptly.NavIcon" android:contentDescription="@null"
                android:src="@drawable/ic_nav_explore" />
            <TextView style="@style/Aptly.NavLabel" android:text="Explore" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_favorites" style="@style/Aptly.NavItem">
            <ImageView style="@style/Aptly.NavIcon" android:contentDescription="@null"
                android:src="@drawable/ic_nav_favorites" />
            <TextView style="@style/Aptly.NavLabel" android:text="Favorites" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_messages" style="@style/Aptly.NavItem">
            <ImageView style="@style/Aptly.NavIcon" android:contentDescription="@null"
                android:src="@drawable/ic_nav_messages" />
            <TextView style="@style/Aptly.NavLabel" android:text="Messages" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="74dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_nav_selected"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView style="@style/Aptly.NavIcon" android:contentDescription="@null"
                android:src="@drawable/ic_nav_profile" android:tint="@color/white" />
            <TextView style="@style/Aptly.NavLabel" android:text="Profile"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
