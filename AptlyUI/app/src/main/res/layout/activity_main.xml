<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 11: DASHBOARD (Explore tab) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Search bar + filter button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="23dp"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="23dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_bar"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_explore"
                    android:tint="#222222" />

                <EditText
                    android:id="@+id/input_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="@string/search_apartments"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/text_black"
                    android:textColorHint="@color/text_light"
                    android:textSize="14sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btn_filter"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_button"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Filter"
                    android:src="@drawable/ic_filter" />
            </FrameLayout>
        </LinearLayout>

        <!-- Results bar: only shown while filters are applied -->
        <LinearLayout
            android:id="@+id/results_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="23dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="23dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/results_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3 results"
                android:textColor="@color/text_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_clear_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp"
                android:text="Clear all"
                android:textColor="@color/button_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Shown instead of the cards when no apartment matches the filters -->
        <TextView
            android:id="@+id/txt_no_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="60dp"
            android:text="@string/no_apartments_match"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Apartment cards (2 per row) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="110dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/cards_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="23dp"
                android:paddingEnd="23dp">

                <!-- Row 1 -->
                <LinearLayout android:id="@+id/card_row_1" style="@style/Aptly.CardRow" android:layout_marginTop="0dp">
                    <!-- Card 1 -->
                    <LinearLayout
                        android:id="@+id/card_1"
                        style="@style/Aptly.Card">
                        <FrameLayout style="@style/Aptly.CardPhotoFrame">
                            <ImageView android:id="@+id/photo_1" style="@style/Aptly.CardPhoto" android:src="@drawable/apt_1" />
                            <ImageView android:id="@+id/heart_1" style="@style/Aptly.CardHeart" />
                        </FrameLayout>
                        <TextView style="@style/Aptly.CardTitle" android:text="Apartment in Aurora Hill" />
                        <LinearLayout style="@style/Aptly.CardInfoRow">
                            <TextView style="@style/Aptly.CardSubtitle" android:text="Pacquiao, Homes" />
                            <TextView style="@style/Aptly.CardRating" android:text="★ 5.00" />
                        </LinearLayout>
                        <TextView android:id="@+id/price_1" style="@style/Aptly.CardPrice" android:text="₱8,500/mo · 1 bedroom" />
                    </LinearLayout>
                    <!-- Card 2 -->
                    <LinearLayout
                        android:id="@+id/card_2"
                        style="@style/Aptly.Card"
                        android:layout_marginStart="16dp">
                        <FrameLayout style="@style/Aptly.CardPhotoFrame">
                            <ImageView android:id="@+id/photo_2" style="@style/Aptly.CardPhoto" android:src="@drawable/apt_2" />
                            <ImageView android:id="@+id/heart_2" style="@style/Aptly.CardHeart" />
                        </FrameLayout>
                        <TextView style="@style/Aptly.CardTitle" android:text="Apartment in Trancoville" />
                        <LinearLayout style="@style/Aptly.CardInfoRow">
                            <TextView style="@style/Aptly.CardSubtitle" android:text="Busseng, Homes" />
                            <TextView style="@style/Aptly.CardRating" android:text="★ 4.75" />
                        </LinearLayout>
                        <TextView android:id="@+id/price_2" style="@style/Aptly.CardPrice" android:text="₱12,000/mo · 2 bedrooms" />
                    </LinearLayout>
                    <!-- Empty right half: shown only when this row has a single card (after filtering) -->
                    <View android:id="@+id/spacer_1" style="@style/Aptly.Card" android:layout_height="1dp" android:layout_marginStart="16dp" android:visibility="gone" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout android:id="@+id/card_row_2" style="@style/Aptly.CardRow">
                    <!-- Card 3 -->
                    <LinearLayout
                        android:id="@+id/card_3"
                        style="@style/Aptly.Card">
                        <FrameLayout style="@style/Aptly.CardPhotoFrame">
                            <ImageView android:id="@+id/photo_3" style="@style/Aptly.CardPhoto" android:src="@drawable/apt_3" />
                            <ImageView android:id="@+id/heart_3" style="@style/Aptly.CardHeart" />
                        </FrameLayout>
                        <TextView style="@style/Aptly.CardTitle" android:text="Apartment in Leonila Hill" />
                        <LinearLayout style="@style/Aptly.CardInfoRow">
                            <TextView style="@style/Aptly.CardSubtitle" android:text="24Chicken, Homes" />
                            <TextView style="@style/Aptly.CardRating" android:text="★ 4.50" />
                        </LinearLayout>
                        <TextView android:id="@+id/price_3" style="@style/Aptly.CardPrice" android:text="₱6,000/mo · 1 bedroom" />
                    </LinearLayout>
                    <!-- Card 4 -->
                    <LinearLayout
                        android:id="@+id/card_4"
                        style="@style/Aptly.Card"
                        android:layout_marginStart="16dp">
                        <FrameLayout style="@style/Aptly.CardPhotoFrame">
                            <ImageView android:id="@+id/photo_4" style="@style/Aptly.CardPhoto" android:src="@drawable/apt_4" />
                            <ImageView android:id="@+id/heart_4" style="@style/Aptly.CardHeart" />
                        </FrameLayout>
                        <TextView style="@style/Aptly.CardTitle" android:text="Apartment in East Bayan Park" />
                        <LinearLayout style="@style/Aptly.CardInfoRow">
                            <TextView style="@style/Aptly.CardSubtitle" android:text="Mommy Oni, Homes" />
                            <TextView style="@style/Aptly.CardRating" android:text="★ 2.50" />
                        </LinearLayout>
                        <TextView android:id="@+id/price_4" style="@style/Aptly.CardPrice" android:text="₱15,000/mo · 3 bedrooms" />
                    </LinearLayout>
                    <!-- Empty right half: shown only when this row has a single card (after filtering) -->
                    <View android:id="@+id/spacer_2" style="@style/Aptly.Card" android:layout_height="1dp" android:layout_marginStart="16dp" android:visibility="gone" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout android:id="@+id/card_row_3" style="@style/Aptly.CardRow">
                    <!-- Card 5 -->
                    <LinearLayout
                        android:id="@+id/card_5"
                        style="@style/Aptly.Card">
                        <FrameLayout style="@style/Aptly.CardPhotoFrame">
                            <ImageView android:id="@+id/photo_5" style="@style/Aptly.CardPhoto" android:src="@drawable/apt_5" />
                            <ImageView android:id="@+id/heart_5" style="@style/Aptly.CardHeart" />
                        </FrameLayout>
                        <TextView style="@style/Aptly.CardTitle" android:text="Apartment in La Trinidad" />
                        <LinearLayout style="@style/Aptly.CardInfoRow">
                            <TextView style="@style/Aptly.CardSubtitle" android:text="Sakading, Homes" />
                            <TextView style="@style/Aptly.CardRating" android:text="★ 3.00" />
                        </LinearLayout>
                        <TextView android:id="@+id/price_5" style="@style/Aptly.CardPrice" android:text="₱7,000/mo · 2 bedrooms" />
                    </LinearLayout>
                    <!-- Card 6 -->
                    <LinearLayout
                        android:id="@+id/card_6"
                        style="@style/Aptly.Card"
                        android:layout_marginStart="16dp">
                        <FrameLayout style="@style/Aptly.CardPhotoFrame">
                            <ImageView android:id="@+id/photo_6" style="@style/Aptly.CardPhoto" android:src="@drawable/apt_6" />
                            <ImageView android:id="@+id/heart_6" style="@style/Aptly.CardHeart" />
                        </FrameLayout>
                        <TextView style="@style/Aptly.CardTitle" android:text="Apartment in Gov. Pack" />
                        <LinearLayout style="@style/Aptly.CardInfoRow">
                            <TextView style="@style/Aptly.CardSubtitle" android:text="Padungking, Homes" />
                            <TextView style="@style/Aptly.CardRating" android:text="★ 4.00" />
                        </LinearLayout>
                        <TextView android:id="@+id/price_6" style="@style/Aptly.CardPrice" android:text="₱10,000/mo · 2 bedrooms" />
                    </LinearLayout>
                    <!-- Empty right half: shown only when this row has a single card (after filtering) -->
                    <View android:id="@+id/spacer_3" style="@style/Aptly.Card" android:layout_height="1dp" android:layout_marginStart="16dp" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Bottom navigation (Explore selected) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_nav"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:id="@+id/nav_explore"
            android:layout_width="74dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_nav_selected"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView style="@style/Aptly.NavIcon" android:contentDescription="@null"
                android:src="@drawable/ic_nav_explore" android:tint="@color/white" />
            <TextView style="@style/Aptly.NavLabel" android:text="Explore"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_favorites" style="@style/Aptly.NavItem">
            <ImageView style="@style/Aptly.NavIcon" android:contentDescription="@null"
                android:src="@drawable/ic_nav_favorites" />
            <TextView style="@style/Aptly.NavLabel" android:text="Favorites" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_messages" style="@style/Aptly.NavItem">
            <ImageView style="@style/Aptly.NavIcon" android:contentDescription="@null"
                android:src="@drawable/ic_nav_messages" />
            <TextView style="@style/Aptly.NavLabel" android:text="Messages" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_profile" style="@style/Aptly.NavItem">
            <ImageView style="@style/Aptly.NavIcon" android:contentDescription="@null"
                android:src="@drawable/ic_nav_profile" />
            <TextView style="@style/Aptly.NavLabel" android:text="Profile" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
