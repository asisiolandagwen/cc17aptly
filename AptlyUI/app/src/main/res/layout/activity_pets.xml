<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 10: Pet-friendly (step 5 of 5) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Step counter -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:text="5 of 5"
        android:textColor="@color/text_black"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="47dp"
            android:paddingTop="118dp"
            android:paddingEnd="48dp">

            <!-- Question -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Do you need a pet-friendly place?"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Choose one."
                android:textColor="@color/text_black"
                android:textSize="12.5sp" />

            <!-- Options (choose one) -->
            <TextView
                android:id="@+id/option_pets_allowed"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Pets allowed"
                android:textColor="@color/text_black"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/option_no_pets"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="No pets allowed"
                android:textColor="@color/text_black"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Submit -->
    <Button
        android:id="@+id/btn_submit"
        style="@style/Aptly.Button"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="46dp"
        android:text="Submit"
        android:textSize="13sp" />
</LinearLayout>
