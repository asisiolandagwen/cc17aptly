<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 7: Bedrooms (step 2 of 5) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Step counter -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:text="2 of 5"
        android:textColor="@color/text_black"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="47dp"
            android:paddingTop="118dp"
            android:paddingEnd="48dp">

            <!-- Question -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How many bedrooms do you need?"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Enter the number of bedrooms you\'d accept."
                android:textColor="@color/text_black"
                android:textSize="12.5sp" />

            <!-- Number of bedrooms -->
            <EditText
                android:id="@+id/input_bedrooms"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_input_outline"
                android:inputType="number"
                android:maxLength="2"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/text_black"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Skip / Next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="46dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_skip"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_gray"
            android:elevation="3dp"
            android:stateListAnimator="@null"
            android:text="Skip"
            android:textAllCaps="false"
            android:textColor="@color/text_black"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_next"
            style="@style/Aptly.Button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:text="Next"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>