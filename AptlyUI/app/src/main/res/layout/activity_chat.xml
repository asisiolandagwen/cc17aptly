<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 11f: Chat (opened from a conversation on the Messages tab) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header: back arrow, avatar, name -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="44dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="16dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="9dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Avatar: colored circle with the first letter (the code sets the person's letter/color) -->
            <TextView
                android:id="@+id/txt_avatar"
                style="@style/Aptly.AvatarLetter"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:backgroundTint="#F2C94C"
                android:text="B"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/txt_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/chat_banana_man"
                android:textColor="@color/text_black"
                android:textSize="13sp" />

            <!-- Only shown when chatting with an apartment host -->
            <TextView
                android:id="@+id/txt_chat_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Host · Apartment in East Bayan Park"
                android:textColor="@color/text_gray"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D6DCD8" />

    <!-- Messages (newest at the bottom) -->
    <ScrollView
        android:id="@+id/scroll_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/list_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Sent message (green bubble on the right). When the app runs, the code replaces
                 this with the real messages of the chat that was opened. -->
            <TextView
                style="@style/Aptly.ChatBubble"
                android:text="@string/chat_first_message" />
        </LinearLayout>
    </ScrollView>

    <!-- Message box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_message_input"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="6dp">

        <EditText
            android:id="@+id/input_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Message"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textShortMessage"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text_black"
            android:textColorHint="#333333"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btn_send"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Send"
            android:padding="7dp"
            android:src="@drawable/ic_send" />
    </LinearLayout>
</LinearLayout>
