<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aptly">

        <!-- 1. Welcome / Select User Type: the app starts here -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:theme="@style/Theme.Aptly.Welcome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Logo screen: shown after Welcome, then opens Sign In -->
        <activity
            android:name=".LogoActivity"
            android:exported="false"
            android:theme="@style/Theme.Aptly.Logo" />

        <!-- 3. Sign In -->
        <activity
            android:name=".SignInActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4. Create Account -->
        <activity
            android:name=".CreateAccountActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. Terms & Conditions -->
        <activity
            android:name=".TermsActivity"
            android:exported="false" />

        <!-- 6. Price range (step 1 of 5) -->
        <activity
            android:name=".PriceRangeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 7. Bedrooms (step 2 of 5) -->
        <activity
            android:name=".BedroomsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 8. Furnishing type (step 3 of 5) -->
        <activity
            android:name=".FurnishingActivity"
            android:exported="false" />

        <!-- 9. Lease type (step 4 of 5) -->
        <activity
            android:name=".LeaseTypeActivity"
            android:exported="false" />

        <!-- 10. Pet-friendly (step 5 of 5) -->
        <activity
            android:name=".PetsActivity"
            android:exported="false" />

        <!-- 11. Dashboard (Explore tab) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 11a. Favorites tab (from Dashboard bottom bar) -->
        <activity
            android:name=".FavoritesActivity"
            android:exported="false" />

        <!-- 11b. Profile tab (from Dashboard bottom bar) -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- 11c. Filters (from Dashboard filter icon) -->
        <activity
            android:name=".FiltersActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 11d. Apartment details (tap a Dashboard card) -->
        <activity
            android:name=".ApartmentDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.Aptly.Details" />

        <!-- 11e. Messages tab (from bottom bar) -->
        <activity
            android:name=".MessagesActivity"
            android:exported="false" />

        <!-- 11f. Chat (tap a conversation on the Messages tab) -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 11g. Edit Profile (Edit links on the Profile tab) -->
        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateVisible" />
    </application>

</manifest>
